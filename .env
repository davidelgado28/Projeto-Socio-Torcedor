```python
import bcrypt
import reflex as rx
from datetime import datetime
from sqlmodel import Field


class Socio(rx.Model, table=True):
    nome: str
    email: str = Field(unique=True, index=True)
    senha_hash: str
    cpf: str = ""
    telefone: str = ""
    plano_id: int | None = Field(default=None, foreign_key="plano.id")
    ativo: bool = True
    is_admin: bool = False
    criado_em: datetime = Field(default_factory=datetime.utcnow)

    def verificar_senha(self, senha: str) -> bool:
        return bcrypt.checkpw(senha.encode(), self.senha_hash.encode())

    @staticmethod
    def hash_senha(senha: str) -> str:
        return bcrypt.hashpw(senha.encode(), bcrypt.gensalt()).decode()


class Plano(rx.Model, table=True):
    nome: str  # ex: "Sócio Bronze", "Sócio Ouro"
    preco_mensal: float
    beneficios: str = ""
